---
import { SEO } from 'astro-seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;

// Canonical URLs are slashed, hrefs are not always. Normalize both sides so the
// active link resolves whichever form is in the address bar.
const normalizePath = (path: string) => (path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path);
const currentPath = normalizePath(Astro.url.pathname);
const isActive = (href: string) => normalizePath(href) === currentPath;

const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/enterprise', label: 'Enterprise' },
  { href: '/systems', label: 'Systems' },
  { href: '/about', label: 'About' },
];
const menuLinks = [
  ...navLinks,
  { href: '/contact', label: 'Contact' },
  { href: '/care', label: 'Care Plan' },
  { href: '/process', label: 'Process' },
];
const footerLinks = menuLinks;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Griffith Creative',
  url: 'https://www.griffithcreative.co',
  logo: 'https://www.griffithcreative.co/icon-512.png',
  image: 'https://www.griffithcreative.co/og-image.png',
  description:
    'Griffith Creative is a web design and infrastructure firm in Los Angeles. We design and build websites, keep them running, and help companies build the systems they run on. Working worldwide.',
  email: 'hello@griffithcreative.co',
  telephone: '+1-310-818-3092',
  foundingDate: '2020',
  areaServed: 'Worldwide',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Los Angeles',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  sameAs: [],
  serviceType: ['Web Design', 'Web Development', 'Website Infrastructure and Hosting Management', 'Operations and Software Cost Audit'],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Griffith Creative',
  url: 'https://www.griffithcreative.co',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/archivo-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />
    <SEO
      title={title}
      description={description}
      canonical={canonical || Astro.url.href}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        basic: {
          title: title,
          type: 'website',
          image: 'https://www.griffithcreative.co/og-image.png',
        },
        optional: {
          description: description,
          siteName: 'Griffith Creative',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: title,
        description: description,
      }}
    />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] bg-accent text-dark font-semibold px-4 py-2 rounded">Skip to content</a>
    <!-- Navigation -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-dark/90 backdrop-blur-md border-b border-offwhite/5">
      <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 shrink-0 text-offwhite font-bold text-xl tracking-tight whitespace-nowrap hover:text-accent transition-colors">
          <svg width="36" height="36" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="w-9 h-9 text-accent"><path fill="currentColor" d="M 81.60 25.47 A 40 40 0 1 1 74.53 18.40 L 53.46 39.46 L 50 36 L 36 50 L 50 64 L 64 50 L 60.54 46.54 Z"/></svg>
          <span class="font-wordmark">Griffith Creative</span>
        </a>

        <!-- Desktop Nav -->
        <nav aria-label="Primary" class="hidden lg:flex items-center gap-8">
          {navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'text-sm font-medium whitespace-nowrap transition-colors',
                isActive(link.href)
                  ? 'text-accent'
                  : 'text-offwhite-muted hover:text-offwhite',
              ]}
            >
              {link.label}
            </a>
          ))}
          <a href="/contact" class="btn btn-primary !py-2.5 !px-5 text-sm">Book a call</a>
        </nav>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden text-offwhite p-2"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile Nav -->
      <nav aria-label="Primary" id="mobile-menu" class="hidden lg:hidden bg-dark border-t border-offwhite/5">
        <div class="px-6 py-4 flex flex-col gap-4">
          {menuLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'text-base font-medium transition-colors',
                isActive(link.href)
                  ? 'text-accent'
                  : 'text-offwhite-muted hover:text-offwhite',
              ]}
            >
              {link.label}
            </a>
          ))}
          <a href="/contact" class="btn btn-primary self-start">Book a call</a>
        </div>
      </nav>
    </header>
    <div id="mobile-menu-backdrop" class="hidden lg:hidden fixed inset-0 z-40 bg-dark/70" aria-hidden="true"></div>

    <!-- Main Content -->
    <main id="main" tabindex="-1" class="flex-1 pt-20 focus:outline-none">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-offwhite/10">
      <div class="container-site pt-10 pb-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
          <a href="mailto:hello@griffithcreative.co" class="md:order-2 text-base md:text-sm font-medium text-offwhite hover:text-accent transition-colors">hello@griffithcreative.co</a>
          <nav aria-label="Footer" class="md:order-1 grid grid-cols-2 gap-x-8 gap-y-3 md:flex md:flex-wrap md:gap-x-7">
            {footerLinks.map((link) => (
              <a href={link.href} class="text-sm text-offwhite-muted hover:text-offwhite transition-colors py-1.5 md:py-0">{link.label}</a>
            ))}
          </nav>
        </div>
        <div class="mt-10 md:mt-8 pt-6 md:pt-0 border-t md:border-t-0 border-offwhite/10 flex flex-col sm:flex-row sm:justify-between gap-2 font-mono text-[11px] uppercase tracking-[0.08em] text-offwhite-muted">
          <p>Los Angeles, working worldwide &middot; Since 2020</p>
          <p>&copy; {new Date().getFullYear()} &middot; <a href="/privacy" class="inline-block py-[15px] -my-[15px] hover:text-offwhite transition-colors">Privacy</a></p>
        </div>
      </div>
    </footer>

    <!-- Mobile Menu Script -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const backdrop = document.getElementById('mobile-menu-backdrop');
      const icon = document.getElementById('menu-icon');
      let open = false;

      const setMenu = (next: boolean) => {
        open = next;
        menu?.classList.toggle('hidden', !open);
        backdrop?.classList.toggle('hidden', !open);
        btn?.setAttribute('aria-expanded', String(open));
        document.documentElement.classList.toggle('overflow-hidden', open);
        document.body.classList.toggle('overflow-hidden', open);
        if (icon) {
          icon.setAttribute('d', open ? 'M6 18L18 6M6 6l12 12' : 'M4 6h16M4 12h16M4 18h16');
        }
      };

      btn?.addEventListener('click', () => setMenu(!open));
      backdrop?.addEventListener('click', () => setMenu(false));

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && open) {
          setMenu(false);
          btn?.focus();
        }
      });
    </script>

  </body>
</html>
