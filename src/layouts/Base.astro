---
import { SEO } from 'astro-seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/enterprise', label: 'Enterprise' },
  { href: '/about', label: 'About' },
];

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Griffith Creative',
  url: 'https://www.griffithcreative.co',
  logo: 'https://www.griffithcreative.co/icon-512.png',
  image: 'https://www.griffithcreative.co/og-image.png',
  description:
    'Web design for growing businesses and established brands. Based in Los Angeles, serving the US.',
  email: 'hello@griffithcreative.co',
  telephone: '+1-310-818-3092',
  foundingDate: '2020',
  areaServed: 'US',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Los Angeles',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  sameAs: [],
  serviceType: ['Web Design', 'Web Development', 'Website Infrastructure and Hosting Management', 'Operations and Software Cost Audit'],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Griffith Creative',
  url: 'https://www.griffithcreative.co',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/archivo-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />
    <SEO
      title={title}
      description={description}
      canonical={canonical || Astro.url.href}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        basic: {
          title: title,
          type: 'website',
          image: 'https://www.griffithcreative.co/og-image.png',
        },
        optional: {
          description: description,
          siteName: 'Griffith Creative',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: title,
        description: description,
      }}
    />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] bg-accent text-dark font-semibold px-4 py-2 rounded">Skip to content</a>
    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-dark/90 backdrop-blur-md border-b border-offwhite/5">
      <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 shrink-0 text-offwhite font-bold text-xl tracking-tight whitespace-nowrap hover:text-accent transition-colors">
          <svg width="36" height="36" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="w-9 h-9"><path fill="#C9A84C" d="M 81.60 25.47 A 40 40 0 1 1 74.53 18.40 L 53.46 39.46 L 50 36 L 36 50 L 50 64 L 64 50 L 60.54 46.54 Z"/></svg>
          <span class="font-wordmark">Griffith Creative</span>
        </a>

        <!-- Desktop Nav -->
        <div class="hidden lg:flex items-center gap-8">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'text-sm font-medium whitespace-nowrap transition-colors',
                currentPath === link.href
                  ? 'text-accent'
                  : 'text-offwhite-muted hover:text-offwhite',
              ]}
            >
              {link.label}
            </a>
          ))}
          <a
            href="/contact"
            class="text-sm font-semibold text-accent whitespace-nowrap hover:text-accent-hover transition-colors"
          >
            Get Started
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden text-offwhite p-2"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile Nav -->
      <div id="mobile-menu" class="hidden lg:hidden bg-dark border-t border-offwhite/5">
        <div class="px-6 py-4 flex flex-col gap-4">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'text-base font-medium transition-colors',
                currentPath === link.href
                  ? 'text-accent'
                  : 'text-offwhite-muted hover:text-offwhite',
              ]}
            >
              {link.label}
            </a>
          ))}
          <a
            href="/contact"
            class="text-base font-semibold text-accent hover:text-accent-hover transition-colors"
          >
            Get Started
          </a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main id="main" class="flex-1 pt-20">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-offwhite/10">
      <div class="max-w-6xl mx-auto px-6 py-20">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-10">
          <div class="min-w-0">
            <div class="flex items-center gap-3 mb-6">
              <svg width="40" height="40" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="w-10 h-10"><path fill="#C9A84C" d="M 81.60 25.47 A 40 40 0 1 1 74.53 18.40 L 53.46 39.46 L 50 36 L 36 50 L 50 64 L 64 50 L 60.54 46.54 Z"/></svg>
              <span class="text-offwhite font-wordmark text-lg">Griffith Creative</span>
            </div>
            <a
              href="mailto:hello@griffithcreative.co"
              class="font-wordmark text-[clamp(1.25rem,6.4vw,3rem)] tracking-tight text-offwhite hover:text-accent transition-colors"
            >
              hello@griffithcreative.co
            </a>
          </div>
          <div class="shrink-0 lg:text-right">
            <a href="tel:+13108183092" class="block font-mono text-offwhite text-sm hover:text-accent transition-colors mb-3">+1 (310) 818-3092</a>
            <p class="font-mono text-offwhite-muted text-xs uppercase tracking-widest whitespace-nowrap">
              Los Angeles, CA &middot; Since 2020
            </p>
          </div>
        </div>

        <nav aria-label="Footer" class="border-t border-offwhite/10 mt-14 pt-8 flex flex-wrap gap-x-8 gap-y-3">
          {[...navLinks.slice(1), { href: '/contact', label: 'Contact' }].map((link) => (
            <a href={link.href} class="text-sm text-offwhite-muted hover:text-offwhite transition-colors">{link.label}</a>
          ))}
        </nav>

        <div class="mt-10 flex flex-col sm:flex-row justify-between items-center gap-4">
          <p class="font-mono text-offwhite-muted text-xs">
            &copy; {new Date().getFullYear()} Griffith Creative
          </p>
          <a href="/privacy" class="font-mono text-offwhite-muted text-xs hover:text-offwhite transition-colors">
            Privacy Policy
          </a>
        </div>
      </div>
    </footer>

    <!-- Mobile Menu Script -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const icon = document.getElementById('menu-icon');
      let open = false;

      btn?.addEventListener('click', () => {
        open = !open;
        menu?.classList.toggle('hidden');
        btn?.setAttribute('aria-expanded', String(open));
        if (icon) {
          icon.setAttribute(
            'd',
            open ? 'M6 18L18 6M6 6l12 12' : 'M4 6h16M4 12h16M4 18h16'
          );
        }
      });
    </script>

    <!-- Scroll Animation Script -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
