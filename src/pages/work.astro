---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    name: 'Nadia Tolar',
    label: 'Personal Portfolio',
    imageUrl: '/work/nadia-tolar.webp',
    projectUrl: 'https://nadiatolar.com',
  },
  {
    name: 'PhaseeLuv',
    label: 'Music Artist',
    imageUrl: '/work/phaseeluv.webp',
    projectUrl: 'https://phaseeluv.pages.dev',
  },
  {
    name: 'SnapToAI',
    label: 'macOS Productivity Tool',
    imageUrl: '/work/snaptoai.webp',
    projectUrl: 'https://snaptoai.app',
  },
  {
    name: 'JAG Creative',
    label: 'Interior Design Studio',
    imageUrl: '/work/jag-creative.webp',
    projectUrl: 'https://jagcreative.com',
  },
  {
    name: 'Amin Mortada',
    label: 'Musician Portfolio',
    imageUrl: '/work/amin-mortada.webp',
    projectUrl: 'https://amin-mortada-portfolio.vercel.app',
  },
  {
    name: 'CA Accounting',
    label: 'Financial Services',
    imageUrl: '/work/ca-accounting.webp',
    projectUrl: 'https://ca-accounting-site.vercel.app/',
  },
  {
    name: 'SBLD Lighting',
    label: 'Production Portfolio',
    imageUrl: '/work/sbld-lighting.webp',
    projectUrl: 'https://sbld.vercel.app/',
  },
];
---

<Base
  title="Selected work — Griffith Creative"
  description="A small selection of websites built by Griffith Creative."
>
  <!-- Page Intro -->
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 fade-in">
          Selected work
        </h1>
        <p class="text-lg md:text-xl text-offwhite-muted leading-relaxed fade-in fade-in-delay-1">
          A few of our favorite projects.
        </p>
      </div>
    </div>
  </section>

  <!-- Project Grid -->
  <section class="pb-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project, i) => (
          <div class:list={['fade-in', `fade-in-delay-${Math.min(i + 1, 4)}`]}>
            <ProjectCard
              name={project.name}
              label={project.label}
              imageUrl={project.imageUrl}
              projectUrl={project.projectUrl}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="py-24 bg-dark-secondary">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <p class="text-2xl md:text-3xl font-bold mb-6 fade-in">
        Working on something? <span class="text-accent">Get in touch.</span>
      </p>
      <a
        href="mailto:hello@griffithcreative.co"
        class="inline-block bg-accent text-dark font-semibold px-8 py-4 rounded hover:bg-accent-hover transition-colors fade-in fade-in-delay-1"
      >
        hello@griffithcreative.co
      </a>
    </div>
  </section>
</Base>
