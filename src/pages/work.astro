---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    name: 'Nadia Tolar',
    label: 'Personal Portfolio',
    imageUrl: '/work/nadia-tolar.webp',
    projectUrl: 'https://nadiatolar.com',
  },
  {
    name: 'SnapToAI',
    label: 'macOS Productivity Tool',
    imageUrl: '/work/snaptoai.webp',
    projectUrl: 'https://snaptoai.app',
  },
  {
    name: 'JAG Creative',
    label: 'Interior Design Studio',
    imageUrl: '/work/jag-creative.webp',
    projectUrl: 'https://jagcreative.com',
  },
  {
    name: 'PhaseeLuv',
    label: 'Music Artist',
    imageUrl: '/work/phaseeluv.webp',
    projectUrl: 'https://phaseeluv.pages.dev',
  },
  {
    name: 'Amin Mortada',
    label: 'Musician Portfolio',
    imageUrl: '/work/amin-mortada.webp',
    projectUrl: 'https://aminmortada.com',
  },
  {
    name: 'CA Accounting',
    label: 'Financial Services',
    imageUrl: '/work/ca-accounting.webp',
    projectUrl: 'https://ca-accounting-site.vercel.app/',
  },
];
---

<Base
  title="Selected work — Griffith Creative"
  description="A selection of websites designed and built by Griffith Creative."
>
  <!-- Page Intro -->
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-6">
      <h1 class="text-5xl md:text-7xl tracking-tight mb-6">
        Selected work
      </h1>
      <p class="text-lg md:text-xl text-offwhite-muted leading-relaxed max-w-2xl">
        Designed, written, and built by Griffith Creative.
      </p>
    </div>
  </section>

  <!-- Projects -->
  <section class="pb-32">
    <div class="max-w-6xl mx-auto px-6">
      <div class="space-y-24 md:space-y-32">
        {projects.map((project, i) => (
          <div class="fade-in">
            <ProjectCard
              name={project.name}
              label={project.label}
              imageUrl={project.imageUrl}
              projectUrl={project.projectUrl}
              eager={i === 0}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="border-t border-offwhite/10 py-32">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-4xl md:text-6xl leading-[1.05] tracking-tight mb-10 text-balance">
        Yours could be next.
      </h2>
      <a
        href="/contact"
        class="inline-block bg-accent text-dark font-bold px-10 py-4 rounded hover:bg-accent-hover transition-colors text-lg"
      >
        Start Your Project
      </a>
    </div>
  </section>
</Base>
