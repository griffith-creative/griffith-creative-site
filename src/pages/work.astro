---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const thumbs = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.webp', { eager: true });
const thumb = (file: string) => thumbs[`../assets/work/${file}`].default;

interface Site {
  name: string;
  caption: string;
  image: ImageMetadata;
  url?: string;
}

interface Industry {
  name: string;
  line: string;
  sites: Site[];
}

const industries: Industry[] = [
  {
    name: 'Music and entertainment',
    line: 'Artists, managers, and labels.',
    sites: [
      { name: 'Amin Mortada', caption: 'aminmortada.com', image: thumb('amin-mortada.webp'), url: 'https://aminmortada.com' },
      { name: 'Nadia Tolar', caption: 'nadiatolar.com', image: thumb('nadia-tolar.webp'), url: 'https://nadiatolar.com' },
    ],
  },
  {
    name: 'Home, trade and construction',
    line: 'Interior designers, contractors, and builders.',
    sites: [
      { name: 'JAG Creative', caption: 'jagcreative.com', image: thumb('jag-creative.webp'), url: 'https://www.jagcreative.com' },
    ],
  },
  {
    name: 'Professional and financial services',
    line: 'Accountants, consultants, and advisors.',
    sites: [
      { name: 'Haven Financial', caption: 'Concept', image: thumb('haven-financial.webp'), url: 'https://havenfinancial.griffithcreative.co' },
      { name: 'Six Points Global', caption: 'sixpointsglobal.com', image: thumb('six-points-global.webp'), url: 'https://six-points-global.vercel.app' },
    ],
  },
  {
    name: 'Retail and product',
    line: 'Online stores and software products.',
    sites: [
      { name: 'Guardian Sleeves', caption: 'guardiansleeves.com', image: thumb('guardian-sleeves.webp'), url: 'https://guardiansleeves.com' },
      { name: 'SnapToAI', caption: 'snaptoai.app', image: thumb('snaptoai.webp'), url: 'https://snaptoai.app' },
    ],
  },
];
---

<Base
  title="Industries | Griffith Creative"
  description="Web design and development for music and entertainment, home and construction, professional and financial services, and retail and product businesses."
>
  <!-- Hero -->
  <section class="py-24 md:py-32">
    <div class="max-w-6xl mx-auto px-6">
      <p class="font-mono text-offwhite-muted text-xs uppercase tracking-widest mb-8">
        Industries
      </p>
      <h1 class="text-[clamp(3rem,8vw,6rem)] leading-[0.95] tracking-tight mb-8 text-balance">
        Who we build for.
      </h1>
      <p class="text-offwhite-muted text-lg md:text-xl leading-relaxed max-w-[580px] text-pretty">
        Web design and development for these industries.
      </p>
    </div>
  </section>

  <!-- Industries -->
  {industries.map((industry) => (
    <section class="border-t border-offwhite/10 py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_440px] gap-10 lg:gap-20 items-start">
        <div>
          <h2 class="text-4xl md:text-5xl leading-[1.0] tracking-tight mb-4 max-w-2xl text-balance">
            {industry.name}
          </h2>
          <p class="text-offwhite-muted text-lg">{industry.line}</p>
        </div>
        <ul class="flex flex-wrap gap-6 lg:pt-2" aria-label={`${industry.name} examples`}>
          {industry.sites.map((site) => (
            <li class="basis-[calc(50%-0.75rem)] sm:basis-52 grow-0 max-w-52">
              <a
                href={site.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block"
              >
                <div class="overflow-hidden rounded-md border border-offwhite/10 aspect-[8/5]">
                  <Image
                    src={site.image}
                    alt={`${site.name}, website by Griffith Creative`}
                    widths={[256, 512]}
                    sizes="(min-width: 640px) 208px, 45vw"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover object-top motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.02]"
                  />
                </div>
                <p class="text-offwhite text-sm mt-3 group-hover:text-accent transition-colors">{site.name}</p>
                <p class="font-mono text-offwhite-muted text-[11px] uppercase tracking-widest mt-1">{site.caption}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <!-- CTA -->
  <section class="border-t border-offwhite/10 py-32">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-6xl leading-[1.05] tracking-tight mb-6 text-balance">
        Don't see your industry?
      </h2>
      <p class="text-offwhite-muted text-lg max-w-[580px] mb-10 text-pretty">
        Get in touch and we'll let you know if it's a fit.
      </p>
      <a href="/contact" class="btn btn-primary">Book a call</a>
    </div>
  </section>
</Base>
