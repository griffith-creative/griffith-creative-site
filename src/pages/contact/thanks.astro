---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Thanks | Griffith Creative"
  description="Thanks for reaching out. We'll be in touch within one business day."
>
  <section class="min-h-[70vh] flex items-center">
    <div class="max-w-3xl mx-auto px-6 py-24 text-center">
      <p class="font-mono text-offwhite-muted text-xs uppercase tracking-widest mb-6">
        Message received
      </p>
      <h1 class="text-4xl md:text-6xl font-extrabold leading-tight tracking-tight mb-6">
        Got it. Talk soon.
      </h1>
      <p class="text-offwhite-muted text-lg md:text-xl leading-relaxed mb-10">
        Thanks for reaching out. We've got your message and will respond within one business day, usually faster. In the meantime, feel free to reply directly to the confirmation email if you think of anything else.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="bg-accent text-dark font-semibold px-8 py-4 rounded text-center hover:bg-accent-hover transition-colors"
        >
          Back to Home
        </a>
        <a
          href="/services"
          class="border border-offwhite/20 text-offwhite font-semibold px-8 py-4 rounded text-center hover:border-offwhite/40 transition-colors"
        >
          Review Services
        </a>
      </div>
    </div>
  </section>
</Base>
