---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Thanks | Griffith Creative"
  description="Thanks for reaching out. We'll be in touch within one business day."
  noindex
>
  <section class="min-h-[70vh] flex items-center">
    <div class="max-w-6xl mx-auto px-6 py-24 w-full">
      <p class="font-mono text-offwhite-muted text-xs uppercase tracking-widest mb-6">
        Message received
      </p>
      <h1 class="text-4xl md:text-6xl leading-[1.05] tracking-tight mb-6">
        Got it. Talk soon.
      </h1>
      <p class="text-offwhite-muted text-lg md:text-xl leading-relaxed max-w-2xl mb-10">
        We'll reply within one business day, usually sooner. A confirmation is on its way to your inbox; replying to it reaches us directly. If you'd rather talk now, book a time or call.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="https://cal.com/griffithcreative/disco"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-accent text-dark font-bold px-10 py-4 rounded text-center hover:bg-accent-hover transition-colors text-lg"
        >
          Book a Call
        </a>
        <a
          href="tel:+13108183092"
          class="border border-offwhite/30 text-offwhite font-semibold px-8 py-4 rounded text-center hover:border-offwhite/60 transition-colors"
        >
          +1 (310) 818-3092
        </a>
      </div>
    </div>
  </section>
</Base>
