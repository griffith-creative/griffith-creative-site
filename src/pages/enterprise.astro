---
import Base from '../layouts/Base.astro';

const partnership = [
  {
    title: 'Built to Scale',
    body: "Traffic spikes shouldn't be a fire drill. We architect for peak load: product launches, press mentions, seasonal demand, live events. Your site holds up when it matters most, not just on a quiet Tuesday.",
  },
  {
    title: 'A Team, Not a Ticket Queue',
    body: "You get a small senior team that knows your business, your stack, and your goals. Not a rotating cast filing support tickets. Priority response, direct access, and the people you talk to are the people who build.",
  },
  {
    title: 'Full-Lifecycle Management',
    body: 'Redesign is the starting point, not the whole engagement. We handle ongoing development, content operations, performance monitoring, security patching, and continuous optimization, so your team can focus on the business.',
  },
  {
    title: 'Modern Infrastructure, Migrated Cleanly',
    body: "Legacy CMS. Years of accumulated tech debt. Third-party scripts nobody remembers adding. We audit what's running under the hood and migrate you to a modern, fast, secure stack without breaking what works.",
  },
  {
    title: 'Security & Compliance',
    body: 'End-of-life software, unpatched dependencies, missing consent management, accessibility gaps. We close them as part of the rebuild: current platforms, hardened headers, privacy compliance, and WCAG-informed markup on every page.',
  },
  {
    title: 'Search & AI Visibility at Scale',
    body: 'Clean structure, schema, and semantic markup across your entire site, not just the homepage. You keep showing up in Google and get cited correctly by AI search engines as your business grows.',
  },
];
---

<Base
  title="Enterprise — Griffith Creative | High-Traffic Website Partnerships"
  description="Griffith Creative designs, rebuilds, and manages high-traffic websites for established companies. Legacy migrations, modern infrastructure, and a dedicated team, without enterprise bloat."
>
  <!-- Hero -->
  <section class="min-h-[80vh] flex items-center">
    <div class="max-w-6xl mx-auto px-6 py-24 w-full">
      <p class="font-mono text-offwhite-muted text-xs uppercase tracking-widest mb-8">
        Enterprise Web Partnerships
      </p>
      <h1 class="text-[clamp(3rem,8vw,6rem)] leading-[0.95] tracking-tight mb-10 max-w-6xl">
        Built for the sites that<br />
        <span class="text-accent">can't afford to go down.</span>
      </h1>
      <p class="text-offwhite-muted text-lg md:text-xl leading-relaxed max-w-2xl mb-12">
        When traffic spikes, deadlines don't move, and stakeholders are watching, your website has to hold. We design, rebuild, and manage high-traffic websites for established companies that need enterprise reliability without enterprise bloat.
      </p>
      <a
        href="/contact"
        class="inline-block border border-accent/40 text-accent font-semibold px-8 py-4 rounded hover:border-accent transition-colors"
      >
        Talk to Our Team
      </a>
    </div>
  </section>

  <!-- Problem -->
  <section class="border-t border-offwhite/10 py-32">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-6xl leading-[1.05] tracking-tight mb-8 max-w-4xl">
        Most agencies weren't built for your traffic.
      </h2>
      <p class="text-offwhite-muted text-lg md:text-xl leading-relaxed max-w-3xl">
        Your site isn't a brochure. It's a live product: generating leads, processing transactions, and representing your brand to every customer who finds you. A dated CMS, a stack of unmanaged tracking scripts, and a team that only shows up for the redesign isn't enough. You need infrastructure that scales on demand and a partner who's still there in month thirteen, not just week one.
      </p>
    </div>
  </section>

  <!-- Total Cost of Ownership -->
  <section class="border-t border-offwhite/10 py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div>
          <p class="font-mono text-offwhite-muted text-xs uppercase tracking-widest mb-6">
            Total Cost of Ownership
          </p>
          <h2 class="text-4xl md:text-5xl leading-[1.05] tracking-tight mb-6 text-balance">
            You're paying enterprise prices to keep old technology alive.
          </h2>
          <p class="text-offwhite-muted text-lg leading-relaxed">
            Legacy platforms accumulate cost the way they accumulate tech debt: enterprise hosting contracts, redundant CDN layers, extended support for end-of-life software, licenses for services you stopped using years ago, and a retainer just to keep it all standing. We audit what you're paying for, then rebuild on modern infrastructure that collapses most of that spend and outperforms what it replaces.
          </p>
        </div>

        <div class="space-y-8">
          <div class="border-l-2 border-accent pl-6">
            <h3 class="text-offwhite text-lg mb-2">Audit the real cost</h3>
            <p class="text-offwhite-muted text-sm leading-relaxed">
              We map every contract, license, and dependency in your current stack and show you what each one is for, and which ones are dead weight.
            </p>
          </div>
          <div class="border-l-2 border-accent pl-6">
            <h3 class="text-offwhite text-lg mb-2">Rebuild on modern infrastructure</h3>
            <p class="text-offwhite-muted text-sm leading-relaxed">
              Static-first architecture on a global edge network. Faster under load, more secure by default, and a fraction of the hosting bill.
            </p>
          </div>
          <div class="border-l-2 border-accent pl-6">
            <h3 class="text-offwhite text-lg mb-2">Keep what works</h3>
            <p class="text-offwhite-muted text-sm leading-relaxed">
              Your data relationships, your measurement stack, your content library. We migrate cleanly instead of burning it down.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partnership -->
  <section class="border-t border-offwhite/10 py-24">
    <div class="max-w-6xl mx-auto px-6">
      <p class="font-mono text-offwhite-muted text-xs uppercase tracking-widest mb-16">
        What Partnership Looks Like
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-12">
        {partnership.map((item) => (
          <div class="border-t border-offwhite/15 pt-6">
            <h3 class="text-offwhite text-xl mb-3 md:min-h-[4rem]">{item.title}</h3>
            <p class="text-offwhite-muted text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Commitments -->
  <section class="border-t border-offwhite/10 py-24">
    <div class="max-w-6xl mx-auto px-6">
      <p class="font-mono text-offwhite-muted text-xs uppercase tracking-widest mb-6">
        What We Commit To
      </p>
      <p class="text-offwhite text-2xl md:text-3xl leading-snug tracking-tight max-w-4xl text-pretty">
        Uptime and performance monitoring on every site we manage. A response within one business day, usually much sooner. High-90s Lighthouse scores we measure before launch. And every commitment written into the agreement, not implied on a landing page.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-offwhite/10 py-32">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-4xl md:text-6xl leading-[1.05] tracking-tight mb-6">
        Bring us the site<br />you can't afford to break.
      </h2>
      <p class="text-offwhite-muted text-lg max-w-2xl mx-auto mb-10">
        The audit comes first: performance, structure, security, and cost, mapped before you commit to anything. You'll know exactly what you're deciding on.
      </p>
      <a
        href="/contact"
        class="inline-block bg-accent text-dark font-bold px-10 py-4 rounded hover:bg-accent-hover transition-colors text-lg"
      >
        Schedule a Discovery Call
      </a>
    </div>
  </section>
</Base>
