---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import dawnWide from '../assets/dawn-wide.webp';
import dawnTall from '../assets/dawn-tall.webp';

// Two plates rather than one, because the hero is a cover crop and a portrait window shows
// barely a quarter of the width the desktop frame shows. Cropping in the pipeline instead of
// in object-position keeps the portrait download at the size it is actually painted; one
// shared plate would have to be four times as wide to hold the same detail.
// Each plate is already cut to its own window, so both sit at object-position 50 percent.
// The tall plate goes to every portrait window, not just to phones: a 3:4 tablet
// center-cropped out of a 16:10 frame loses the dome off the left edge.
// Both masters are now the window at its native size in the 8K source rather than resized on
// the way out, so every rung is real pixels and not an upscale: the tall plate at 2129 by
// 4608 and the wide plate at 7372 by 4608. Four portrait windows used to share a 1440 rung,
// and every window past 2880 device pixels used to share the wide plate's top rung.
// The wide master is the same window, also at its native size in the source rather than a
// 2880 by 1800 downscale, so the top of the ladder is real pixels too. 2880 was the ceiling
// and a 1440 by 1200 window paints 3840 device pixels, an ultrawide 3440 paints 3440, and a
// 1680 by 1050 at 2x paints 3360. All three fetched a plate narrower than the box.
// The tall ladder tops out at the master's own 2129 rather than at 2048. A 1050 by 1680 window
// at 2x paints 2100 device pixels of plate and used to take the 2048 rung, and anything larger
// took it too. The last rung costs a few KB and it is the last real pixel there is.
const wide = [1024, 1280, 1440, 1728, 1920, 2560, 2880, 3456, 3840];
const tall = [390, 480, 585, 780, 960, 1170, 1290, 1440, 1728, 2048, 2129];
const quality = 50;
// The tall plate is a sky at a tenth of the wide plate's pixel count, so the same quality
// number buys far fewer bits per degree of sky and the gradient starts to step. It gets its
// own rung: still a few KB at 780, and the banding measured out of it.
const tallQuality = 57;

const [wideAvif, wideWebp, tallAvif, tallWebp] = await Promise.all([
  getImage({ src: dawnWide, widths: wide, format: 'avif', quality }),
  getImage({ src: dawnWide, widths: wide, format: 'webp', quality }),
  getImage({ src: dawnTall, widths: tall, format: 'avif', quality: tallQuality }),
  getImage({ src: dawnTall, widths: tall, format: 'webp', quality: tallQuality }),
]);
const fallback = await getImage({ src: dawnWide, width: 1440, format: 'webp', quality });

// object-fit: cover paints the plate at max(box width, box height x plate aspect), so in any
// window taller than the plate's own aspect the painted width runs past 100vw and a plain
// 100vw hint under-serves it. Each plate states its own cover width instead.
// The wide crop is 7372 by 4608, which is 1.59983, so 8/5 and 1.6 still describe it to within
// a hundredth of a percent and the hint does not need to carry the ugly number.
const wideSizes = '(min-aspect-ratio: 8/5) 100vw, calc(100vh * 1.6)';
// Cover paints the tall plate at whichever of the two dimensions runs short, same as the
// wide one, so in a window narrower than the plate's own 2129 by 4608 the painted width runs
// past 100vw. A plain 100vw hint under-served those by up to 30 percent at 320 by 900.
const tallSizes = '(min-aspect-ratio: 2129/4608) 100vw, calc(100vh * 0.46202)';
// The tall plate only ever paints in a portrait window, which is where the art direction
// switches to it. The switch is on orientation alone: what breaks the wide plate is the box
// being narrower than the frame, not the box being small, so a width gate only moved the
// cliff. At 1201 by 1600 and at a portrait-rotated 1440 by 2560 the width gate handed a
// 16 by 10 frame to a 3 by 4 box and cropped the dome off the left edge.
const tallMedia = '(orientation: portrait)';
// Each source states its own plate's aspect, so the box is right on either art direction and
// not just on the desktop fallback the img element describes. The numbers come off the
// pipeline's copy of the master: reading them off the import instead makes Astro ship the
// 2.7MB source file into the deploy.
const wideDims = [wideAvif.options.src.width, wideAvif.options.src.height];
const tallDims = [tallAvif.options.src.width, tallAvif.options.src.height];
// The loop is served from public/ rather than the image pipeline, and the filename carries
// its version so the immutable cache header in vercel.json stays honest. The mp4 is at v2
// because its encode changed; the webm bytes are untouched, so it keeps v1.
const loopMp4 = '/media/dawn-loop-v2.mp4';
const loopWebm = '/media/dawn-loop-v1.webm';

const offers = [
  {
    title: 'Design and build',
    body: 'Custom websites, designed and written in house, built on a static-first stack and served from the edge.',
    href: '/services/',
  },
  {
    title: 'Enterprise',
    body: 'Rebuilds, migrations, and ongoing management for high-traffic sites and the companies behind them.',
    href: '/enterprise/',
  },
  {
    title: 'Systems',
    body: 'Systems that fit how a company actually works. Storage, software, and the workflows between them, reviewed and rebuilt around the team.',
    href: '/systems/',
  },
];
---

<Base
  title="Griffith Creative | Web Design and Infrastructure, Los Angeles"
  description="Griffith Creative is a web design and infrastructure firm in Los Angeles. We design and build websites, keep them running, and help companies build the systems they run on. Working worldwide."
  heroArt
>
  <section class="hero-dawn">
    <!-- Decorative: dawn over the observatory, downtown behind it. The plate paints on first
         byte and the loop is swapped in later, so nothing here is on the load path. The ink
         is a gradient over the art rather than part of it, so the type carries at both
         widths without a second render of the picture. -->
    <div class="dawn" aria-hidden="true" data-dawn>
      <picture class="dawn-plate">
        <source media={tallMedia} type="image/avif" srcset={tallAvif.srcSet.attribute} sizes={tallSizes} width={tallDims[0]} height={tallDims[1]} />
        <source media={tallMedia} type="image/webp" srcset={tallWebp.srcSet.attribute} sizes={tallSizes} width={tallDims[0]} height={tallDims[1]} />
        <source type="image/avif" srcset={wideAvif.srcSet.attribute} sizes={wideSizes} width={wideDims[0]} height={wideDims[1]} />
        <source type="image/webp" srcset={wideWebp.srcSet.attribute} sizes={wideSizes} width={wideDims[0]} height={wideDims[1]} />
        <img
          src={fallback.src}
          alt=""
          width={fallback.options.width}
          height={fallback.options.height}
          loading="eager"
          decoding="async"
        />
      </picture>
      <video
        class="dawn-loop"
        data-mp4={loopMp4}
        data-webm={loopWebm}
        preload="none"
        muted
        loop
        playsinline
        disablepictureinpicture
        aria-hidden="true"
        tabindex="-1"
      ></video>
      <div class="dawn-ink"></div>
    </div>

    <div class="container-site hero-grid">
      <p class="eyebrow">Los Angeles &middot; Worldwide</p>
      <div class="hero-body">
        <h1 class="h1">We design websites<br class="hidden md:inline" /> and keep them running.</h1>
        <a href="/contact/" class="btn btn-primary btn-over-art">Book a call</a>
      </div>
    </div>
  </section>

  <script>
    // The dawn loop is ambient, so it waits for the page to be interactive and then idle
    // before it asks for a byte. It never loads at all under reduced motion or Save-Data.
    const art = document.querySelector<HTMLElement>('[data-dawn]');
    const video = art?.querySelector<HTMLVideoElement>('video');

    if (art && video) {
      const stillMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
      let loaded = false;

      // AV1 in WebM is a sixth of the H.264 file at the same measured quality. Anything that
      // cannot decode it, Safari on most hardware included, gets the mp4.
      const pick = () => {
        const webm = video.dataset.webm;
        if (webm && video.canPlayType('video/webm; codecs="av01.0.05M.08"') === 'probably') return webm;
        return video.dataset.mp4;
      };

      const stop = () => {
        video.pause();
        video.removeAttribute('src');
        video.load();
        delete video.dataset.playing;
        loaded = false;
      };

      const load = () => {
        if (loaded || stillMotion.matches || saveData) return;
        const src = pick();
        if (!src) return;
        loaded = true;
        video.muted = true;
        video.src = src;
        video.play().then(
          () => {
            video.dataset.playing = '';
          },
          () => stop(),
        );
      };

      // The loop cuts straight at the wrap. A dissolve out to the plate used to sit here, on
      // the theory that it hid the step from the loop's tail back to its head. Measured, the
      // step is 4.4 percent and the dissolve put a 13.8 percent one in its place, over 800ms,
      // and timeupdate fires too coarsely for the fade to finish before the cut anyway. The
      // raw seam is the quieter of the two, so there is nothing here but the loop.

      // Nothing to animate once the hero is off screen.
      if ('IntersectionObserver' in window) {
        new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!loaded) continue;
            if (entry.isIntersecting) void video.play().catch(() => {});
            else video.pause();
          }
        }).observe(art);
      }

      stillMotion.addEventListener('change', (event) => {
        if (event.matches) stop();
        else load();
      });

      const queue = () => {
        if ('requestIdleCallback' in window) window.requestIdleCallback(load, { timeout: 2500 });
        else window.setTimeout(load, 800);
      };

      if (document.readyState === 'complete') queue();
      else window.addEventListener('load', queue, { once: true });
    }
  </script>

  <section class="section">
    <div class="container-site">
      <h2 class="h2 mb-12">What we do</h2>
      <div class="rule-cols rule-cols-3">
        {offers.map((o) => (
          <a href={o.href} class="flex flex-col gap-3">
            <h3 class="col-title">{o.title}</h3>
            <p class="col-para">{o.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site two-col">
      <h2 class="h2">Who we build for</h2>
      <div class="flex flex-col items-start gap-6">
        <p class="para">
          Music and entertainment. Home, trade and construction. Professional and financial services. Retail&nbsp;and&nbsp;product.
        </p>
        <a href="/work/" class="next-link">Industries</a>
      </div>
    </div>
  </section>

  <section class="section-close">
    <div class="container-site close">
      <div class="close-main">
        <h2 class="h2-close">Start with a call.</h2>
        <a href="/contact/" class="btn btn-primary btn-over-art">Book a call</a>
      </div>
      <div class="close-next">
        <a href="/services/" class="next-link">What we do</a>
      </div>
    </div>
  </section>
</Base>
