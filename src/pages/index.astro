---
import Base from '../layouts/Base.astro';

const offers = [
  {
    title: 'Design and build',
    body: 'Custom websites, designed and written in house, built on a static-first stack and served from the edge.',
    href: '/services/',
  },
  {
    title: 'Enterprise',
    body: 'Rebuilds, migrations, and ongoing management for high-traffic sites and the companies behind them.',
    href: '/enterprise/',
  },
  {
    title: 'Systems',
    body: 'Systems that fit how a company actually works. Storage, software, and the workflows between them, reviewed and rebuilt around the team.',
    href: '/systems/',
  },
];
---

<Base
  title="Griffith Creative | Web Design and Infrastructure, Los Angeles"
  description="Griffith Creative is a web design and infrastructure firm in Los Angeles. We design and build websites, keep them running, and help companies build the systems they run on. Working worldwide."
>
  <section class="hero">
    <div class="container-site">
      <p class="eyebrow mb-7">Los Angeles &middot; Worldwide</p>
      <h1 class="h1 mb-7">We design websites<br class="hidden md:inline" /> and keep them running.</h1>
      <p class="lede mb-8">
        Web design and infrastructure, Los Angeles. We build the sites companies depend on and look after what&nbsp;sits&nbsp;behind&nbsp;them.
      </p>
      <a href="/contact/" class="btn btn-primary">Book a call</a>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <h2 class="h2 mb-10">What we do</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
        {offers.map((o) => (
          <div>
            <h3 class="text-xl font-semibold mb-3"><a href={o.href} class="hover:text-accent transition-colors">{o.title}</a></h3>
            <p class="text-offwhite-muted leading-[1.65]">{o.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <p class="statement">
        Every project starts with a call and a written scope. You own the code, the domain, and the accounts. After launch we monitor it, patch it, and pick&nbsp;up&nbsp;the&nbsp;phone.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-site two-col">
      <h2 class="h2">Who we build for</h2>
      <p class="para">
        Music and entertainment. Home, trade and construction. Professional and financial services. Retail and product. Those are where most of our work has been, and the same approach carries to any company that depends on&nbsp;its&nbsp;website.
      </p>
    </div>
  </section>

  <section class="section py-24 md:py-32">
    <div class="container-site">
      <h2 class="h2-close mb-8">Start with a call.</h2>
      <a href="/contact/" class="btn btn-primary">Book a call</a>
    </div>
  </section>
</Base>
