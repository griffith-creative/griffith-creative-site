---
import Base from '../layouts/Base.astro';

const stack = [
  {
    title: 'Static-first sites',
    body: 'Built to a page and served from a global edge network. Fast by default, secure by default.',
  },
  {
    title: 'Storage and email',
    body: 'Object storage for archives. Email sent from your own domain, with the records set up so it lands.',
  },
  {
    title: 'Whatever you already run',
    body: 'Booking, CRM, e-commerce, accounting. We integrate with the tools the business uses rather than replacing them.',
  },
];
---

<Base
  title="About | Griffith Creative"
  description="Griffith Creative is a web design and infrastructure firm founded in Los Angeles in 2020. We design, build, and run sites for companies around the world, and review the systems behind them."
>
  <section class="hero">
    <div class="container-site hero-grid">
      <p class="eyebrow">About</p>
      <div class="hero-body">
        <h1 class="h1">Los Angeles, since 2020.</h1>
        <p class="lede">
          We started out building websites for people we knew. Today we design, build, and run sites for companies around&nbsp;the&nbsp;world.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <div class="stacked">
        <h2 class="h2">How we work</h2>
        <p class="para">
          Senior people on every job, with no account layer between you and the work. A written scope and a fixed price before anything starts. Code, domain, hosting, and accounts in your name from day one. Every site measured before it&nbsp;goes&nbsp;live.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <h2 class="h2 mb-12">What we build on</h2>
      <div class="rule-cols rule-cols-3">
        {stack.map((item) => (
          <div class="flex flex-col gap-3">
            <h3 class="col-title">{item.title}</h3>
            <p class="col-para">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-close">
    <div class="container-site close">
      <div class="close-main">
        <h2 class="h2-close">Talk to us directly.</h2>
        <a href="/contact/" class="btn btn-primary">Book a call</a>
      </div>
      <div class="close-next">
        <a href="/work/" class="next-link">Industries</a>
      </div>
    </div>
  </section>
</Base>
