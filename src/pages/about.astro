---
import Base from '../layouts/Base.astro';
---

<Base
  title="About | Griffith Creative"
  description="Griffith Creative is a web design and infrastructure firm founded in Los Angeles in 2020. We design, build, and run sites for companies around the world, and review the systems behind them."
>
  <section class="hero">
    <div class="container-site">
      <p class="eyebrow mb-7">About</p>
      <h1 class="h1 mb-7">Los Angeles, since 2020.</h1>
      <p class="lede">
        We started out building websites for people we knew. Today we design, build, and run sites for companies around the world.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <div class="stacked">
        <h2 class="h2">How we work</h2>
        <p class="para">
          Senior people on every job, with no account layer between you and the work. A written scope and a fixed price before anything starts. Code, domain, hosting, and accounts in your name from day one. Every site measured before it goes live.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <h2 class="h2 mb-10">What we build on</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
        <div>
          <h3 class="text-xl font-semibold mb-3">Static-first sites</h3>
          <p class="text-offwhite-muted leading-[1.65]">Built to a page and served from a global edge network. Fast by default, secure by default.</p>
        </div>
        <div>
          <h3 class="text-xl font-semibold mb-3">Storage and email</h3>
          <p class="text-offwhite-muted leading-[1.65]">Object storage for archives. Email sent from your own domain, with the records set up so it lands.</p>
        </div>
        <div>
          <h3 class="text-xl font-semibold mb-3">Whatever you already run</h3>
          <p class="text-offwhite-muted leading-[1.65]">Booking, CRM, e-commerce, accounting. We integrate with the tools the business uses rather than replacing them.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section py-24 md:py-32">
    <div class="container-site">
      <h2 class="h2-close mb-8">Start with a call.</h2>
      <a href="/contact" class="btn btn-primary">Book a call</a>
    </div>
  </section>
</Base>
