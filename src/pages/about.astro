---
import Base from '../layouts/Base.astro';
---

<Base
  title="About | Griffith Creative"
  description="Griffith Creative is a web design and infrastructure firm founded in Los Angeles in 2020. We design, build, and run sites for companies around the world, and review the systems behind them."
>
  <section class="hero">
    <div class="container-site">
      <p class="eyebrow mb-7">About</p>
      <h1 class="h1 mb-7">Los Angeles, since 2020.</h1>
      <p class="lede">
        Griffith Creative started out building websites for people we knew. Today we design, build, and run sites for companies around the world, and review the systems behind them.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-site two-col">
      <h2 class="h2">How we work</h2>
      <p class="para">
        Senior people on every job, with no account layer between you and the work. A written scope and a fixed price before anything starts. Code, domain, hosting, and accounts in your name from day one. Every site measured before it goes live.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-site two-col">
      <h2 class="h2">What we build on</h2>
      <p class="para">
        Static-first sites served from a global edge network. Object storage for archives. Email on your own domain. And whatever your business already runs on: booking, CRM, e-commerce, accounting. We integrate rather than replace.
      </p>
    </div>
  </section>

  <section class="section py-24 md:py-32">
    <div class="container-site">
      <h2 class="h2-close mb-8">Start with a call.</h2>
      <a href="/contact" class="btn btn-primary">Book a call</a>
    </div>
  </section>
</Base>
