---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page Not Found | Griffith Creative"
  description="The page you're looking for doesn't exist. Head back to the homepage or contact us if you need help."
>
  <section class="min-h-[70vh] flex items-center">
    <div class="max-w-3xl mx-auto px-6 py-24 text-center">
      <p class="text-accent font-bold text-7xl md:text-9xl mb-6">404</p>
      <h1 class="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight mb-6 text-balance">
        This page wandered off.
      </h1>
      <p class="text-offwhite-muted text-lg leading-relaxed mb-10">
        The page you're looking for doesn't exist or has moved. Let's get you back on track.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="btn btn-primary"
        >
          Back to Home
        </a>
        <a
          href="/contact"
          class="btn btn-secondary"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Base>
