---
import Base from '../layouts/Base.astro';

const offers = [
  {
    title: 'Design and build',
    body: 'A custom site, scoped to the business and quoted in writing. Copy, design, and code by the same small team.',
    href: '/process/',
  },
  {
    title: 'Care Plan',
    body: 'A monthly plan for sites we build. Updates, hosting, monitoring, and priority support.',
    href: '/care/',
  },
  {
    title: 'Enterprise',
    body: 'Rebuilds and ongoing management for high-traffic sites. A senior team with response times in the agreement.',
    href: '/enterprise/',
  },
  {
    title: 'Systems',
    body: 'Storage, software, and workflows reviewed and rebuilt around how your team actually works.',
    href: '/systems/',
  },
];
---

<Base
  title="Services | Griffith Creative"
  description="Websites designed, built, and looked after in house, and two services for companies with more than a website to run. Griffith Creative, Los Angeles."
>
  <section class="hero">
    <div class="container-site">
      <p class="eyebrow mb-7">Services</p>
      <h1 class="h1 mb-7">Design, build, care.</h1>
      <p class="lede">
        Websites designed, built, and looked after in house, and two services for companies with more than a website to run.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
        {offers.map((o) => (
          <div>
            <h2 class="text-xl font-semibold mb-3">
              {o.href ? <a href={o.href} class="hover:text-accent transition-colors">{o.title}</a> : o.title}
            </h2>
            <p class="text-offwhite-muted leading-[1.65]">{o.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <p class="statement">Everything is scoped in writing before it starts. Everything we build is yours.</p>
    </div>
  </section>

  <section class="section py-24 md:py-32">
    <div class="container-site">
      <h2 class="h2-close mb-8">Tell us what you need.</h2>
      <a href="/contact/" class="btn btn-primary">Book a call</a>
    </div>
  </section>
</Base>
